{
  "name": "papaya-asign-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Papaya Health Insurance Claims Assessment Copilot Monorepo",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @papaya/api db:generate",
    "db:push": "pnpm --filter @papaya/api db:push",
    "db:seed": "pnpm --filter @papaya/api db:seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3"
  }
}
