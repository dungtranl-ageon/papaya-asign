{
  "name": "papaya-asign-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Papaya Health Insurance Claims Assessment Copilot Monorepo",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest run",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @papaya/api db:generate",
    "db:push": "pnpm --filter @papaya/api db:push",
    "db:seed": "pnpm --filter @papaya/api db:seed",
    "db:provider:sqlite": "npx tsx scripts/switch-db-provider.ts sqlite",
    "db:provider:postgres": "npx tsx scripts/switch-db-provider.ts postgres",
    "db:provider:auto": "npx tsx scripts/switch-db-provider.ts auto",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
