# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.prisma text eol=lf
*.sh text eol=lf

# Binary files - do not touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.db binary
*.sqlite binary
