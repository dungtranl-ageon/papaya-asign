# ==============================================================================
# PAPAYA CLAIMS ASSESSMENT COPILOT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in your root directory before running local services.
# NEVER commit real credentials, API keys, or production tokens to git.

NODE_ENV=development

# ------------------------------------------------------------------------------
# API Service Configuration (apps/api - NestJS 10+)
# ------------------------------------------------------------------------------
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Web Client Configuration (apps/web - Next.js 15+)
# ------------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Database Connection (Prisma ORM)
# ------------------------------------------------------------------------------
# OPTION 1: Default zero-setup SQLite database (Recommended for local host development)
# To sync Prisma: run `pnpm db:provider:sqlite`
DATABASE_URL="file:../../../data/papaya_claims.db"

# OPTION 2: PostgreSQL for Docker / Enterprise deployment
# When enabling, run: `pnpm db:provider:postgres` to switch Prisma datasource provider.
# - For local host connecting to Docker Postgres: localhost:5432
#   DATABASE_URL="postgresql://papaya:papaya_secret@localhost:5432/papaya_claims?schema=public"
# - For containers connecting inside Docker network: postgres:5432
#   DATABASE_URL="postgresql://papaya:papaya_secret@postgres:5432/papaya_claims?schema=public"

# ------------------------------------------------------------------------------
# AI Engine & LLM Provider (Mastra Engine + Vercel AI SDK)
# OpenAI-Compatible Gateway (Supports local Ollama, Ollama Cloud, OpenRouter, OpenAI)
# ------------------------------------------------------------------------------
OPENAI_BASE_URL="http://localhost:11434/v1"
OPENAI_API_KEY="ollama"
MODEL_NAME="llama3.3"

# ------------------------------------------------------------------------------
# MCP Tooling Configuration
# ------------------------------------------------------------------------------
MCP_STDIO_ENABLED=true
MCP_LOG_LEVEL=info
