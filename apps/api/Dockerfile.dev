# syntax=docker/dockerfile:1
# ==============================================================================
# Development Dockerfile for NestJS API (apps/api)
# Supports Hot-Reloading & Live Volume Mounts
# ==============================================================================

FROM node:22-alpine
RUN corepack enable pnpm

WORKDIR /app

# Copy monorepo manifests
COPY pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/ packages/
COPY apps/api/package.json apps/api/
COPY apps/api/prisma apps/api/prisma

# Install dependencies including devDependencies
RUN pnpm install --frozen-lockfile=false

# Generate Prisma Client (defaults to SQLite or detected provider)
RUN pnpm --filter @papaya/api db:generate

EXPOSE 3001

CMD ["pnpm", "--filter", "@papaya/api", "dev"]
